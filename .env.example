# ─── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pai_travels?schema=public"

# Signs admin session cookies. At least 32 random characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# First admin account, created/updated by `npm run db:seed` (password min 12 chars).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Public URL of the site (used for canonical URLs, sitemap and emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Business details shown on the site (placeholders are used if unset) ──────

NEXT_PUBLIC_SITE_NAME="Pai Travels"
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_CONTACT_PHONE="+91 00000 00000"
NEXT_PUBLIC_CONTACT_ADDRESS="Office address"
NEXT_PUBLIC_CONTACT_HOURS="Mon–Sat, 10:00–18:00 IST"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_LOCALE="en-IN"

# ─── Optional: email notifications via Resend (https://resend.com) ───────────
# Without these, inquiries and messages are still stored and visible in /admin.

RESEND_API_KEY=""
EMAIL_FROM="Pai Travels <bookings@yourdomain.com>"
ADMIN_NOTIFY_EMAIL="you@yourdomain.com"

# ─── Optional: reading trip details from images (Admin → Import past trips) ───
# Uploaded photos/screenshots are read by Claude. Without a key, uploads are still
# stored but details must be typed in by hand. Create a key at
# https://console.anthropic.com → API keys, then restart the server.

ANTHROPIC_API_KEY=""
# Model used for reading images (default: claude-opus-5)
ANTHROPIC_MODEL=""

# ─── Optional: images ─────────────────────────────────────────────────────────

# Extra hosts allowed for image URLs, comma separated (images.unsplash.com is always allowed).
# Changing this requires a rebuild.
IMAGE_REMOTE_HOSTS=""

# Where admin uploads are stored (must be a persistent disk in production).
UPLOAD_DIR="uploads"
